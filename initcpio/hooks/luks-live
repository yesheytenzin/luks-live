#!/usr/bin/ash

run_hook() {
  local audio_pid= _tries=0

  [ -r /usr/share/plymouth/themes/omaliveboot/boot.conf ] || return 0
  . /usr/share/plymouth/themes/omaliveboot/boot.conf

  command -v plymouth >/dev/null 2>&1 || return 0
  # Wait briefly for plymouth daemon to be pingable; without this the
  # intro is skipped entirely on fast boots where the hook runs before
  # plymouth has started. Do not return early – the sleep is the gate.
  while ! plymouth --ping >/dev/null 2>&1; do
    _tries=$((_tries + 1))
    if [ "$_tries" -ge 50 ]; then
      break
    fi
    sleep 0.1 2>/dev/null || sleep 1
  done

  if [ "${AUDIO_ENABLED:-0}" = 1 ] && command -v aplay >/dev/null 2>&1; then
    modprobe -a snd_hda_intel snd_sof_pci_intel_tgl >/dev/null 2>&1 || true
    if command -v alsactl >/dev/null 2>&1 && [ -r /var/lib/alsa/asound.state ]; then
      alsactl -f /var/lib/alsa/asound.state restore >/dev/null 2>&1 || true
    fi
    aplay -q -D "${AUDIO_DEVICE}" /usr/share/plymouth/themes/omaliveboot/intro.wav >/dev/null 2>&1 &
    audio_pid=$!
  fi

  plymouth display-message --text="__luks_live_start__" >/dev/null 2>&1 || true

  # Theme animation is wall-clock based (Plymouth.GetTime). This hook
  # is the matching wall-clock gate: hold LUKS until INTRO_DURATION has
  # elapsed since the sentinel above resets the Plymouth timer, so
  # preview and boot share the same start point.
  if ! sleep "${INTRO_DURATION}" 2>/dev/null; then
    _int=${INTRO_DURATION%%.*}
    _frac=${INTRO_DURATION#*.}
    if [ "${INTRO_DURATION}" = "${_frac}" ]; then _frac=""; fi
    if [ -n "${_int}" ] && [ "${_int}" != "0" ]; then sleep "${_int}" 2>/dev/null || true; fi
    if [ -n "${_frac}" ] && [ "${_frac}" != "" ] && [ "${_frac}" != "0" ] && [ "${_frac}" != "00" ] && [ "${_frac}" != "000" ]; then
      case ${#_frac} in 1) _frac="${_frac}00";; 2) _frac="${_frac}0";; esac
      if command -v usleep >/dev/null 2>&1; then
        usleep $((_frac * 1000)) 2>/dev/null || true
      elif command -v python3 >/dev/null 2>&1; then
        python3 -c "import time; time.sleep(${_frac}/1000.0)" 2>/dev/null || sleep 0.1 2>/dev/null || true
      else
        _ms=${_frac}
        while [ "${_ms}" -ge 100 ]; do sleep 0.1 2>/dev/null || break; _ms=$((_ms - 100)); done
        if [ "${_ms}" -gt 0 ] 2>/dev/null; then
          if [ "${_ms}" -ge 50 ]; then sleep 0.05 2>/dev/null || sleep 0.1 2>/dev/null || true
          else sleep 0.02 2>/dev/null || sleep 0.1 2>/dev/null || true; fi
        fi
      fi
    fi
  fi

  if [ -n "$audio_pid" ] && kill -0 "$audio_pid" >/dev/null 2>&1; then
    kill "$audio_pid" >/dev/null 2>&1 || true
  fi
  [ -z "$audio_pid" ] || wait "$audio_pid" 2>/dev/null || true
}
