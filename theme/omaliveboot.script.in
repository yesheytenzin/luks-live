# Generated by Luks Live. The numeric placeholders are replaced at install time.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

global.frame_count = @FRAME_COUNT@;
global.intro_duration = @INTRO_DURATION@;
global.fps = @FPS@;
global.intro_complete = 0;
global.password_shown = 0;
global.start_time = Plymouth.GetTime();
global.last_frame = -1;

background.image = Image("frames/0.png").Scale(Window.GetWidth(), Window.GetHeight());
background.sprite = Sprite(background.image);
background.sprite.SetPosition(0, 0, 0);

fun finish_intro() {
  if (global.intro_complete == 1) return;
  global.intro_complete = 1;
  global.last_frame = global.frame_count - 1;
  background.image = Image("frames/" + (global.frame_count - 1) + ".png").Scale(Window.GetWidth(), Window.GetHeight());
  background.sprite.SetImage(background.image);
}

fun refresh_callback() {
  if (global.intro_complete == 1) return;

  elapsed = Plymouth.GetTime() - global.start_time;

  if (elapsed >= global.intro_duration) {
    finish_intro();
    return;
  }

  frame = Math.Int(elapsed * global.fps);
  if (frame < 0) frame = 0;
  if (frame >= global.frame_count) frame = global.frame_count - 1;

  if (frame != global.last_frame) {
    global.last_frame = frame;
    background.image = Image("frames/" + frame + ".png").Scale(Window.GetWidth(), Window.GetHeight());
    background.sprite.SetImage(background.image);
  }
}

Plymouth.SetRefreshRate(60);
Plymouth.SetRefreshFunction(refresh_callback);

lock.image = Image("lock.png");
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

entry.sprite = Sprite(entry.image);
entry.x = Window.GetWidth() * @ENTRY_X@ - entry.image.GetWidth() / 2;
entry.y = Window.GetHeight() * @ENTRY_Y@ - entry.image.GetHeight() / 2;
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

lock_height = entry.image.GetHeight() * 0.8;
lock_scale = lock_height / lock.image.GetHeight();
lock_width = lock.image.GetWidth() * lock_scale;
lock.scaled_image = lock.image.Scale(lock_width, lock_height);
lock.sprite = Sprite(lock.scaled_image);
lock.x = entry.x - lock_width - 15;
lock.y = entry.y + entry.image.GetHeight() / 2 - lock_height / 2;
lock.sprite.SetPosition(lock.x, lock.y, 10001);
lock.sprite.SetOpacity(0);

bullet.sprites = [];

fun show_password_dialog() {
  finish_intro();
  lock.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);
}

fun hide_password_dialog() {
  lock.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);
  for (index = 0; bullet.sprites[index]; index++)
    bullet.sprites[index].SetOpacity(0);
}

fun display_password_callback(prompt, bullets) {
  global.password_shown = 1;
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);
  show_password_dialog();

  for (index = 0; bullet.sprites[index]; index++)
    bullet.sprites[index].SetOpacity(0);

  bullets_to_show = bullets;
  if (bullets_to_show > 21) bullets_to_show = 21;

  for (index = 0; index < bullets_to_show; index++) {
    if (!bullet.sprites[index]) {
      bullet.sprites[index] = Sprite(bullet.image.Scale(7, 7));
      bullet.x = entry.x + 20 + index * 12;
      bullet.y = entry.y + entry.image.GetHeight() / 2 - 3.5;
      bullet.sprites[index].SetPosition(bullet.x, bullet.y, 10002);
    }
    bullet.sprites[index].SetOpacity(1);
  }
}

fun display_normal_callback() {
  hide_password_dialog();
  if (global.password_shown == 1) {
    progress_box.sprite.SetOpacity(1);
    progress_bar.sprite.SetOpacity(1);
  }
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.x = Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = entry.y + entry.image.GetHeight() / 2 - progress_box.image.GetHeight() / 2;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 10);
progress_box.sprite.SetOpacity(0);

progress_bar.original_image = Image("progress_bar.png");
progress_bar.sprite = Sprite(progress_bar.original_image.Scale(1, progress_bar.original_image.GetHeight()));
progress_bar.x = Window.GetWidth() / 2 - progress_bar.original_image.GetWidth() / 2;
progress_bar.y = progress_box.y + (progress_box.image.GetHeight() - progress_bar.original_image.GetHeight()) / 2;
progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 11);
progress_bar.sprite.SetOpacity(0);

fun progress_callback(duration, progress) {
  if (global.password_shown == 0) return;
  width = Math.Int(progress_bar.original_image.GetWidth() * progress);
  if (width < 1) width = 1;
  progress_bar.sprite.SetImage(progress_bar.original_image.Scale(width, progress_bar.original_image.GetHeight()));
}

Plymouth.SetBootProgressFunction(progress_callback);

message.sprite = Sprite();
message.sprite.SetPosition(10, 10, 10003);

fun display_message_callback(text) {
  message.sprite.SetImage(Image.Text(text, 1, 1, 1));
  message.sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
  message.sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
